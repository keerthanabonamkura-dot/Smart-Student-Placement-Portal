# Server Port (Render injects process.env.PORT automatically)
PORT=5000
NODE_ENV=production

# Frontend URL for CORS (e.g. Your Vercel domain)
FRONTEND_URL=https://your-placement-portal.vercel.app

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Database Connection:
# OPTION A: Single Service URI (Recommended for Aiven MySQL)
# DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@mysql-xxxx-project.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# OPTION B: Discrete connection variables
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=placement_portal

# Set to "true" when connecting to Aiven / Cloud MySQL (enforces SSL)
DB_SSL=false
